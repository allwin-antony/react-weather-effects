{
  "name": "react-weather-effects",
  "version": "0.1.0-beta.0",
  "description": "Lightweight, composable 2D canvas weather visual effects for React",
  "license": "MIT",
  "keywords": [
    "react",
    "weather",
    "effects",
    "canvas",
    "rain",
    "snow",
    "fog"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@react-weather-effects/core": "workspace:*",
    "@react-weather-effects/effects": "workspace:*"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs'); if(fs.existsSync('dist/index.d.ts')) fs.copyFileSync('dist/index.d.ts', 'dist/index.d.mts');\"",
    "dev": "tsup --watch"
  }
}