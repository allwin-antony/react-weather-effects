{
  "name": "react-weather-overlays-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @react-weather-overlays/core build && pnpm --filter @react-weather-overlays/effects build && pnpm --filter react-weather-overlays build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "size": "size-limit",
    "demo": "pnpm --filter weather-overlays-demo dev"
  },
  "devDependencies": {
    "@size-limit/esbuild": "^11.2.0",
    "@size-limit/file": "^11.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "vitest-canvas-mock": "^0.3.3"
  }
}
