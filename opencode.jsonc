{
    "$schema": "https://opencode.ai/config.json",
    "providers": {
        "agentrouter": {
            "name": "AgentRouter",
            "env": [
                "AGENTROUTER_API_KEY"
            ],
            "package": "@opencode/ai/providers/openai-compatible/responses",
            "settings": {
                "baseURL": "https://agentrouter.org/v1",
                "apiKey": "{env:AGENTROUTER_API_KEY}"
            },
            "models": {
                "gpt-6-astra": {
                    "modelID": "gpt-6-astra",
                    "name": "GPT-6 Astra",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                },
                "gpt-6.1-sol": {
                    "modelID": "gpt-6.1-sol",
                    "name": "GPT-6.1 Sol",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    }
                }
            }
        }
    },
    "model": "agentrouter/gpt-6-astra"
}
